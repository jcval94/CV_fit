<!DOCTYPE html>
<html lang="{{ cv.language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ cv.candidate.name }} — {{ cv.target_role }}</title>
<style>
:root{--primary:{{ style.primary }};--secondary:{{ style.secondary }};--accent:{{ style.accent }};--surface:{{ style.surface }};--text:{{ style.text }};--muted:{{ style.muted }};--head-font:{{ style.heading_font_stack }};--body-font:{{ style.body_font_stack }};}
*{box-sizing:border-box;margin:0;padding:0}
html,body{margin:0;padding:0}
body{font-family:var(--body-font);font-size:9.8pt;line-height:1.36;color:var(--text);background:#e9edf2;padding:18px 0}
.page{width:8.5in;height:11in;background:var(--surface);padding:.52in .64in;margin:0 auto 18px;box-shadow:0 7px 24px rgba(15,23,42,.14);position:relative;overflow:visible;page-break-after:always}
.page:last-child{page-break-after:auto}
.resume-header{margin-bottom:12px;padding-bottom:10px;border-bottom:3px solid var(--primary)}
.header-row{display:flex;align-items:flex-end;justify-content:space-between;gap:18px}
.name{font-family:var(--head-font);font-size:22pt;line-height:1.02;letter-spacing:.2px;font-weight:750;color:var(--text)}
.headline{font-family:var(--head-font);font-size:10.5pt;font-weight:650;color:var(--primary);margin-top:4px}
.contact{margin-top:7px;font-size:8.6pt;line-height:1.35;color:var(--muted);display:flex;flex-wrap:wrap;gap:2px 10px}
.contact a{color:inherit;text-decoration:none}
.page2-head{font-family:var(--head-font);display:flex;justify-content:space-between;align-items:center;font-size:8.5pt;color:var(--muted);padding-bottom:6px;margin-bottom:10px;border-bottom:1px solid #d6dae0}
.section{margin-bottom:11px}
.section-title{font-family:var(--head-font);font-size:9.5pt;line-height:1.1;font-weight:750;letter-spacing:.85px;text-transform:uppercase;color:var(--primary);margin-bottom:6px;display:flex;align-items:center;gap:8px}
.section-title:after{content:"";height:1px;background:color-mix(in srgb,var(--primary) 28%,#d6dae0);flex:1}
.summary{font-size:9.4pt;line-height:1.42;border-left:3px solid var(--accent);padding-left:10px;color:var(--text)}
.exp{margin-bottom:9px;break-inside:avoid}
.exp:last-child{margin-bottom:0}
.exp-head{display:flex;justify-content:space-between;align-items:baseline;gap:14px}
.org{font-family:var(--head-font);font-size:10pt;font-weight:750;color:var(--text)}
.period{font-size:8.5pt;color:var(--muted);white-space:nowrap}
.role-title{font-size:9.1pt;font-weight:650;color:var(--secondary);margin:1px 0 3px}
ul.bullets{padding-left:16px}
ul.bullets li{margin-bottom:2.5px;font-size:9pt;line-height:1.35}
.education-list,.cert-list{list-style:none;padding:0}
.education-list li,.cert-list li{font-size:8.9pt;line-height:1.35;margin-bottom:3px}
.project{margin-bottom:7px;break-inside:avoid}
.project-name{font-family:var(--head-font);font-size:9.3pt;font-weight:700;color:var(--text);margin-bottom:2px}
.skills-line{display:flex;flex-wrap:wrap;gap:3px 0;font-size:8.9pt;line-height:1.35}
.skill{white-space:normal}
.skill:not(:last-child):after{content:"  •  ";color:var(--accent);font-weight:700;white-space:pre}
@page{size:letter;margin:0}
@media print{body{background:#fff;padding:0}.page{width:8.5in;height:11in;margin:0;box-shadow:none;-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>
{% for page in pages %}
<section class="page" data-page="{{ page.page_number }}">
  {% if page.show_header %}
  <header class="resume-header" data-section="header">
    <div class="header-row"><div><h1 class="name">{{ cv.candidate.name }}</h1><div class="headline">{{ cv.headline.text }}</div></div></div>
    <div class="contact">
      {% if cv.candidate.location %}<span>{{ cv.candidate.location }}</span>{% endif %}
      {% if cv.candidate.phone %}<span>{{ cv.candidate.phone }}</span>{% endif %}
      {% if cv.candidate.email %}<a href="mailto:{{ cv.candidate.email }}">{{ cv.candidate.email }}</a>{% endif %}
      {% if cv.candidate.linkedin %}<span>{{ cv.candidate.linkedin }}</span>{% endif %}
      {% if cv.candidate.github %}<span>{{ cv.candidate.github }}</span>{% endif %}
      {% if cv.candidate.website %}<span>{{ cv.candidate.website }}</span>{% endif %}
    </div>
  </header>
  {% else %}<div class="page2-head" data-section="continuation_header"><span>{{ cv.candidate.name }}</span><span>{{ labels.page }} {{ page.page_number }} / {{ page.total_pages }}</span></div>{% endif %}

  {% if page.show_summary %}<section class="section" data-section="summary"><h2 class="section-title">{{ labels.summary }}</h2><p class="summary">{{ cv.summary.text }}</p></section>{% endif %}

  {% if page.experience %}<section class="section" data-section="experience"><h2 class="section-title">{{ labels.experience }}</h2>{% for item in page.experience %}<article class="exp" data-item="experience"><div class="exp-head"><span class="org">{{ item.organization }}</span><span class="period">{{ item.period }}</span></div><div class="role-title">{{ item.title }}</div>{% if item.bullets %}<ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}</section>{% endif %}

  {% if page.education %}<section class="section" data-section="education"><h2 class="section-title">{{ labels.education }}</h2><ul class="education-list">{% for item in page.education %}<li data-item="education">{{ item.text }}</li>{% endfor %}</ul></section>{% endif %}

  {% if page.projects %}<section class="section" data-section="projects"><h2 class="section-title">{{ labels.projects }}</h2>{% for item in page.projects %}<article class="project" data-item="project"><div class="project-name">{{ item.name }}</div>{% if item.bullets %}<ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}</section>{% endif %}

  {% if page.skills %}<section class="section" data-section="skills"><h2 class="section-title">{{ labels.skills }}</h2><div class="skills-line">{% for item in page.skills %}<span class="skill" data-item="skill">{{ item.text }}</span>{% endfor %}</div></section>{% endif %}

  {% if page.certifications %}<section class="section" data-section="certifications"><h2 class="section-title">{{ labels.certifications }}</h2><ul class="cert-list">{% for item in page.certifications %}<li data-item="certification">{{ item.text }}</li>{% endfor %}</ul></section>{% endif %}
</section>
{% endfor %}
</body>
</html>
