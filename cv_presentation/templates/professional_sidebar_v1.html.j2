<!DOCTYPE html>
<html lang="{{ cv.language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ cv.candidate.name }} — {{ cv.target_role }}</title>
<style>
:root{--primary:{{ style.primary }};--secondary:{{ style.secondary }};--accent:{{ style.accent }};--surface:{{ style.surface }};--text:{{ style.text }};--muted:{{ style.muted }};--head-font:{{ style.heading_font_stack }};--body-font:{{ style.body_font_stack }};}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:var(--body-font);background:#e5e7eb;color:var(--text);line-height:1.42;padding:20px 0}.page{width:8.5in;height:11in;margin:0 auto 20px;background:var(--surface);display:grid;grid-template-columns:2fr 1fr;overflow:visible;box-shadow:0 8px 24px rgba(0,0,0,.12);page-break-after:always}.page:last-child{page-break-after:auto}.main{padding:.52in .48in}.side{padding:.52in .30in;background:var(--primary);color:var(--surface)}h1{font-family:var(--head-font);font-size:25pt;line-height:1.05;text-transform:uppercase;letter-spacing:.8px}.tag{color:var(--accent);font-weight:700;font-size:10.5pt;margin-top:5px}.contact{font-size:8.5pt;color:var(--muted);border-bottom:1px solid #d1d5db;padding:10px 0 12px;margin-bottom:17px;display:flex;flex-wrap:wrap;gap:6px 12px}.section{margin-bottom:16px}.section h2,.side h2{font-size:10pt;text-transform:uppercase;letter-spacing:1.2px;margin-bottom:9px;font-weight:700}.section h2{border-bottom:2px solid #e5e7eb;padding-bottom:5px}.side h2{border-bottom:1px solid rgba(255,255,255,.35);padding-bottom:5px}.role{margin-bottom:14px;break-inside:avoid}.role-head{display:flex;justify-content:space-between;gap:12px;align-items:baseline}.role-title{font-size:10.2pt;font-weight:700}.period{font-size:8.3pt;color:var(--muted);white-space:nowrap}.org{display:block;color:var(--accent);font-size:9.3pt;font-weight:700;margin:2px 0 5px}.bullets{padding-left:15px}.bullets li{font-size:8.8pt;margin-bottom:4px}.side p,.side li{font-size:8.4pt;line-height:1.45}.side ul{padding-left:15px}.side .block{margin-bottom:17px}.project{margin-bottom:9px}.project strong{display:block;font-size:8.8pt}.page2-head{font-family:var(--head-font);font-size:10pt;color:var(--muted);border-bottom:1px solid #d1d5db;padding-bottom:7px;margin-bottom:14px;display:flex;justify-content:space-between}.contact a{color:inherit;text-decoration:none}@page{size:letter;margin:0}@media print{body{background:#fff;padding:0}.page{margin:0;box-shadow:none;-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>
{% for page in pages %}
<section class="page">
  <main class="main">
    {% if page.show_header %}
    <header>
      <h1>{{ cv.candidate.name }}</h1>
      <div class="tag">{{ cv.headline.text }}</div>
      <div class="contact">
        {% if cv.candidate.location %}<span>{{ cv.candidate.location }}</span>{% endif %}
        {% if cv.candidate.email %}<a href="mailto:{{ cv.candidate.email }}">{{ cv.candidate.email }}</a>{% endif %}
        {% if cv.candidate.phone %}<span>{{ cv.candidate.phone }}</span>{% endif %}
        {% if cv.candidate.linkedin %}<span>{{ cv.candidate.linkedin }}</span>{% endif %}
        {% if cv.candidate.github %}<span>{{ cv.candidate.github }}</span>{% endif %}
        {% if cv.candidate.website %}<span>{{ cv.candidate.website }}</span>{% endif %}
      </div>
    </header>
    {% else %}<div class="page2-head"><span>{{ cv.candidate.name }}</span><span>{{ labels.page }} {{ page.page_number }} / {{ page.total_pages }}</span></div>{% endif %}

    {% if page.experience %}<section class="section"><h2>{{ labels.experience }}</h2>{% for item in page.experience %}<article class="role"><div class="role-head"><span class="role-title">{{ item.title }}</span><span class="period">{{ item.period }}</span></div><span class="org">{{ item.organization }}</span><ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul></article>{% endfor %}</section>{% endif %}
    {% if page.projects %}<section class="section"><h2>{{ labels.projects }}</h2>{% for item in page.projects %}<article class="project"><strong>{{ item.name }}</strong><ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul></article>{% endfor %}</section>{% endif %}
  </main>
  <aside class="side">
    {% if page.show_summary %}<div class="block"><h2>{{ labels.summary }}</h2><p>{{ cv.summary.text }}</p></div>{% endif %}
    {% if page.skills %}<div class="block"><h2>{{ labels.skills }}</h2><ul>{% for item in page.skills %}<li>{{ item.text }}</li>{% endfor %}</ul></div>{% endif %}
    {% if page.education %}<div class="block"><h2>{{ labels.education }}</h2><ul>{% for item in page.education %}<li>{{ item.text }}</li>{% endfor %}</ul></div>{% endif %}
    {% if page.certifications %}<div class="block"><h2>{{ labels.certifications }}</h2><ul>{% for item in page.certifications %}<li>{{ item.text }}</li>{% endfor %}</ul></div>{% endif %}
  </aside>
</section>
{% endfor %}
</body></html>
