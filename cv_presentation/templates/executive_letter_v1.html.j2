<!DOCTYPE html>
<html lang="{{ cv.language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ cv.candidate.name }} — {{ cv.target_role }}</title>
<style>
:root{--primary:{{ style.primary }};--secondary:{{ style.secondary }};--accent:{{ style.accent }};--surface:{{ style.surface }};--text:{{ style.text }};--muted:{{ style.muted }};--head-font:{{ style.heading_font_stack }};--body-font:{{ style.body_font_stack }};}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:var(--body-font);color:var(--text);background:#e5e7eb;font-size:10.2pt;line-height:1.42;padding:20px 0}.page{width:8.5in;height:11in;padding:.62in .72in;background:var(--surface);margin:0 auto 20px;box-shadow:0 8px 24px rgba(0,0,0,.12);overflow:hidden;page-break-after:always}.page:last-child{page-break-after:auto}.resume-header{text-align:center;margin-bottom:16px}.name{font-family:var(--head-font);font-size:25pt;font-weight:700;text-transform:uppercase;letter-spacing:1.4px;color:var(--primary);line-height:1.08}.headline{font-size:10.5pt;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--secondary);margin:5px 0 9px}.contact{font-size:8.8pt;color:var(--text);display:flex;justify-content:center;flex-wrap:wrap;gap:3px 9px}.contact a{color:inherit;text-decoration:none}.section{margin-bottom:15px}.section-title{font-family:var(--head-font);font-size:12.5pt;text-transform:uppercase;letter-spacing:.8px;color:var(--primary);border-bottom:1px solid color-mix(in srgb,var(--accent) 45%,#d1d5db);padding-bottom:3px;margin-bottom:9px}.summary{font-size:9.5pt;line-height:1.5;text-align:justify}.exp{margin-bottom:12px;break-inside:avoid}.exp-head{display:flex;justify-content:space-between;gap:14px;align-items:baseline}.org{font-weight:700;font-size:10.2pt;color:var(--primary)}.period{font-size:8.8pt;color:var(--muted);white-space:nowrap}.title{font-style:italic;font-weight:600;font-size:9.5pt;margin:1px 0 4px}.bullets{padding-left:17px}.bullets li{font-size:9.1pt;line-height:1.42;margin-bottom:3px;text-align:justify}.skills-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 20px}.skill{font-size:9pt}.project{margin-bottom:9px;break-inside:avoid}.project-name{font-weight:700;color:var(--primary);font-size:9.7pt}.flat-list{padding-left:17px}.flat-list li{font-size:9pt;margin-bottom:3px}.page2-head{display:flex;justify-content:space-between;border-bottom:1px solid #d1d5db;padding-bottom:6px;margin-bottom:13px;font-family:var(--head-font);color:var(--muted);font-size:9pt}@page{size:letter;margin:0}@media print{body{background:#fff;padding:0}.page{margin:0;box-shadow:none;-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>
{% for page in pages %}
<section class="page">
  {% if page.show_header %}<header class="resume-header"><h1 class="name">{{ cv.candidate.name }}</h1><div class="headline">{{ cv.headline.text }}</div><div class="contact">{% if cv.candidate.location %}<span>{{ cv.candidate.location }}</span>{% endif %}{% if cv.candidate.phone %}<span>• {{ cv.candidate.phone }}</span>{% endif %}{% if cv.candidate.email %}<a href="mailto:{{ cv.candidate.email }}">• {{ cv.candidate.email }}</a>{% endif %}{% if cv.candidate.linkedin %}<span>• {{ cv.candidate.linkedin }}</span>{% endif %}{% if cv.candidate.github %}<span>• {{ cv.candidate.github }}</span>{% endif %}{% if cv.candidate.website %}<span>• {{ cv.candidate.website }}</span>{% endif %}</div></header>{% else %}<div class="page2-head"><span>{{ cv.candidate.name }}</span><span>{{ labels.page }} {{ page.page_number }} / {{ page.total_pages }}</span></div>{% endif %}
  {% if page.show_summary %}<section class="section"><h2 class="section-title">{{ labels.summary }}</h2><p class="summary">{{ cv.summary.text }}</p></section>{% endif %}
  {% if page.experience %}<section class="section"><h2 class="section-title">{{ labels.experience }}</h2>{% for item in page.experience %}<article class="exp"><div class="exp-head"><span class="org">{{ item.organization }}</span><span class="period">{{ item.period }}</span></div><div class="title">{{ item.title }}</div><ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul></article>{% endfor %}</section>{% endif %}
  {% if page.skills %}<section class="section"><h2 class="section-title">{{ labels.skills }}</h2><div class="skills-grid">{% for item in page.skills %}<div class="skill">{{ item.text }}</div>{% endfor %}</div></section>{% endif %}
  {% if page.education %}<section class="section"><h2 class="section-title">{{ labels.education }}</h2><ul class="flat-list">{% for item in page.education %}<li>{{ item.text }}</li>{% endfor %}</ul></section>{% endif %}
  {% if page.projects %}<section class="section"><h2 class="section-title">{{ labels.projects }}</h2>{% for item in page.projects %}<article class="project"><div class="project-name">{{ item.name }}</div><ul class="bullets">{% for bullet in item.bullets %}<li>{{ bullet.text }}</li>{% endfor %}</ul></article>{% endfor %}</section>{% endif %}
  {% if page.certifications %}<section class="section"><h2 class="section-title">{{ labels.certifications }}</h2><ul class="flat-list">{% for item in page.certifications %}<li>{{ item.text }}</li>{% endfor %}</ul></section>{% endif %}
</section>
{% endfor %}
</body></html>
