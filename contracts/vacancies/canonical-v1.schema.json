{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jcval94/CV_fit/contracts/vacancies/canonical-v1.schema.json",
  "title": "Canonical Vacancy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vacancy_id",
    "company",
    "role_title",
    "tech_stack",
    "requirements",
    "responsibilities",
    "fit_strengths",
    "fit_gaps",
    "identity_key",
    "content_hash",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "vacancy_id": {"type": "string", "pattern": "^vac-[a-f0-9]{16}$"},
    "company": {"type": "string", "minLength": 1},
    "role_title": {"type": "string", "minLength": 1},
    "seniority": {"type": ["string", "null"]},
    "company_category": {"type": ["string", "null"]},
    "location_raw": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "work_model": {"type": ["string", "null"]},
    "posted_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "posted_date_raw": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "salary": {"type": ["string", "null"]},
    "tech_stack": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "responsibilities": {"type": "array", "items": {"type": "string"}},
    "description": {"type": ["string", "null"]},
    "fit_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "fit_summary": {"type": ["string", "null"]},
    "fit_strengths": {"type": "array", "items": {"type": "string"}},
    "fit_gaps": {"type": "array", "items": {"type": "string"}},
    "identity_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "source_hash", "source_format", "source_entry_index"],
        "properties": {
          "source_path": {"type": "string"},
          "source_hash": {"type": "string"},
          "source_format": {"enum": ["gptw_v1", "vacantes_v1"]},
          "source_entry_index": {"type": "integer", "minimum": 0},
          "source_native_id": {"type": ["string", "null"]},
          "source_commit": {"type": ["string", "null"]},
          "source_updated_at": {"type": ["string", "null"]},
          "source_search_date": {"type": ["string", "null"]}
        }
      }
    }
  }
}
